  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "MAX_SECOM_DS01",
  "alternateName": "SECOM 반도체 공정 불량 검사 데이터",
  "description": "반도체 제조 공정의 센서 계측값을 이용하여 제품의 합격/불량(Pass/Fail) 여부를 판별하기 위한 학습 데이터",
  "citeAs": "@misc{MAX_SECOM_DS01,\n  title  = {SECOM 반도체 공정 불량 검사 데이터},\n  author = {MAX 추진단},\n  year   = {2026},\n  note   = {MAX_SECOM_DS01, version 1.0}\n}",
  "version": "1.0",
  "datePublished": "2026-09-07",
  "keywords": [
    "반도체",
    "반도체 제조 공정 (센서 기반 공정 모니터링)",
    "Tabular",
    "Anomaly Detection"
  ],
  "license": "https://maxalliance.kr/license/license.html",
  "creator": {
    "@type": "sc:Organization",
    "name": "MAX 추진단"
  },
  "isLiveDataset": true,
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "data-train",
      "name": "data-train",
      "description": "train 데이터 파일(라벨 컬럼 포함)",
      "contentUrl": "MAX_SECOM_DS01/data/train/uci-secom.csv",
      "encodingFormat": "text/csv"
    },
    {
      "@type": "cr:FileObject",
      "@id": "data-test",
      "name": "data-test",
      "description": "test 데이터 파일(라벨 컬럼 포함)",
      "contentUrl": "MAX_SECOM_DS01/data/test/uci-secom.csv",
      "encodingFormat": "text/csv"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "classes",
      "name": "classes",
      "description": "클래스 정의",
      "dataType": "sc:Enumeration",
      "key": {
        "@id": "classes/id"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "classes/id",
          "name": "id",
          "description": "클래스 인덱스",
          "dataType": "sc:Integer"
        },
        {
          "@type": "cr:Field",
          "@id": "classes/name",
          "name": "name",
          "description": "클래스 이름",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "classes/id": -1,
          "classes/name": "Pass"
        },
        {
          "classes/id": 1,
          "classes/name": "Fail"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "splits",
      "name": "splits",
      "dataType": "cr:Split",
      "key": {
        "@id": "splits/name"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "splits/name",
          "name": "name",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "splits/ratio",
          "name": "ratio",
          "dataType": "sc:Float"
        }
      ],
      "data": [
        {
          "splits/name": "train",
          "splits/ratio": 0.8
        },
        {
          "splits/name": "test",
          "splits/ratio": 0.2
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "records-train",
      "name": "records-train",
      "description": "train 데이터 레코드. 라벨('Pass/Fail')과 피처 590개 컬럼(엑셀 셀 참조로 지정된)을 같은 행에서 추출한다.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "records-train/label",
          "name": "label",
          "description": "라벨(데이터 컬럼 'Pass/Fail')",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "data-train"
            },
            "extract": {
              "column": "Pass/Fail"
            }
          },
          "references": {
